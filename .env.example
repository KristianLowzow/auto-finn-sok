# Kopier denne filen til .env for lokal testing. Aldri commit .env eller
# den ekte nøkkelfilen -- begge er utelukket i .gitignore.

# Google Sheets: enten path til nøkkelfilen (lokalt) eller hele JSON-innholdet (som i GitHub secret)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account-key.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

SHEET_ID=

# Gmail SMTP + app-passord for e-postvarsling
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=
